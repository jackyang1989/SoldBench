{
  "name": "soldbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "build": "tsc -b && python3 scripts/build-developer-assets.py",
    "typecheck": "tsc -b --pretty false && tsc -p developer/examples/tsconfig.json",
    "lint": "biome check apps packages scripts tests",
    "lint:fix": "biome check --write apps packages scripts tests",
    "test": "npm run build && node scripts/test.mjs",
    "test:step0": "python3 step0/tools/validate_offline.py",
    "contracts": "python3 docs/contracts/check_contracts.py && python3 -m unittest discover -s docs/contracts -p 'test_compatibility.py'",
    "check": "npm run lint && npm run typecheck && npm test && npm run contracts",
    "dev": "npm run build && node --env-file-if-exists=.env scripts/dev.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "npm run build && node scripts/migrate.mjs",
    "db:encrypt-image-urls": "npm run build && node --env-file-if-exists=.env scripts/encrypt-image-source-urls.mjs",
    "collector:demo": "npm run build && node --env-file-if-exists=.env scripts/collector-demo.mjs",
    "collector:maintain": "npm run build && node --env-file-if-exists=.env scripts/collector-maintenance.mjs",
    "collector:spool-cleanup": "npm run build && node --env-file-if-exists=.env scripts/collector-spool-cleanup.mjs",
    "collector:worker": "npm run build && node --env-file-if-exists=.env scripts/collector-worker.mjs",
    "collector:html-demo": "npm run build && node --env-file-if-exists=.env scripts/collector-html-demo.mjs",
    "collector:run": "npm run build && node --env-file-if-exists=.env scripts/collector-launcher.mjs",
    "collector:intake": "npm run build && node --env-file-if-exists=.env scripts/collector-intake.mjs",
    "collector:handoff": "npm run build && node --env-file-if-exists=.env scripts/collector-handoff.mjs",
    "collector:supervise": "npm run build && node --env-file-if-exists=.env scripts/collector-supervisor.mjs",
    "query:worker": "npm run build && node --env-file-if-exists=.env scripts/query-worker.mjs",
    "auth:mail": "npm run build && node --env-file-if-exists=.env scripts/offline-mail.mjs",
    "collector:media": "npm run build && node --env-file-if-exists=.env scripts/collector-worker.mjs --media-only=true",
    "collector:report": "npm run build && node --env-file-if-exists=.env scripts/collector-report.mjs",
    "collector:refresh": "npm run build && node --env-file-if-exists=.env scripts/collector-refresh.mjs",
    "collector:http-demo": "npm run build && node --env-file-if-exists=.env scripts/collector-html-demo.mjs --http",
    "developer:demo": "npm run build && node --env-file-if-exists=.env scripts/developer-demo.mjs",
    "payment:fixture": "npm run build && node --env-file-if-exists=.env scripts/payment-fixture.mjs",
    "payment:replay-export": "npm run build && node --env-file-if-exists=.env scripts/payment-replay-export.mjs",
    "payment:reconcile": "npm run build && node --env-file-if-exists=.env scripts/payment-reconcile.mjs",
    "billing:audit": "npm run build && node --env-file-if-exists=.env scripts/billing-audit.mjs",
    "public:fixture": "npm run build && node --env-file-if-exists=.env scripts/public-fixture.mjs",
    "privacy:recovery": "npm run build && node --env-file-if-exists=.env scripts/privacy-recovery.mjs",
    "test:readiness": "npm run build && node scripts/test.mjs tests/readiness.test.mjs tests/collector-isolation.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "@biomejs/biome": "2.6.8",
    "esbuild": "0.28.2",
    "@modelcontextprotocol/client": "2.4.0",
    "playwright-core": "1.65.1"
  }
}
