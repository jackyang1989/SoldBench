# Secrets are mounted files outside the source tree. See the deployment runbook for modes.
SOLDBENCH_SECRETS_DIR=./.secrets
AUTH_SECRETS_VERSION=initial

# Safe offline defaults. The base Compose file publishes no host ports.
SOLDBENCH_ISOLATED_DEPLOYMENT=true
SOLDBENCH_LIVE_GATE_ACKNOWLEDGED=false
DATA_MODE=offline_fixture
COLLECTOR_ENABLED=false
PAYMENTS_MODE=offline
PAYMENT_FIXTURES=false
MAIL_TRANSPORT=offline
APP_ORIGIN=http://soldbench.test

# Use the existing bootstrap administrator on a legacy PostgreSQL volume.
POSTGRES_DB=soldbench
POSTGRES_USER=soldbench_bootstrap

# Set only when a source has been provisioned and its Collector profile is intentional.
# COLLECTOR_SOURCE_ID=
# COLLECTOR_PROXY_URL=

# Formal activation requires the original gates and the explicit edge overlay.
# SOLDBENCH_ISOLATED_DEPLOYMENT=false
# SOLDBENCH_LIVE_GATE_ACKNOWLEDGED=true
# APP_ORIGIN=https://soldbench.com

# Set provider inputs only for their approved transport and approved scope.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MERCHANT_ID=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MERCHANT_ID=
# MAIL_FROM=support@soldbench.com
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
