# Production deployment environment template for SoldBench.
# NOTE: Real production activation remains gated behind G0-G5 sign-off and authorized infrastructure.
# Keep safe offline defaults intact until explicit gate approval.

# --- Safe Mode Gates (MUST remain offline/false until approved) ---
NODE_ENV=development
DATA_MODE=offline_fixture
COLLECTOR_ENABLED=false
PAYMENTS_MODE=offline
PAYMENT_FIXTURES=false
DB_STARTUP_MODE=verify

# --- Public Origins & Bindings (Deployment Targets) ---
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://soldbench.com
API_ORIGIN=https://api.soldbench.com/v1
SUPPORT_EMAIL=support@soldbench.com

# --- Isolated Database Roles (Least Privilege) ---
POSTGRES_DB=soldbench
POSTGRES_USER=soldbench_app
POSTGRES_PASSWORD=replace-with-strong-app-password
# Runtime API + Query Worker connection (SELECT/INSERT/UPDATE/DELETE only, zero DDL):
DATABASE_URL=postgresql://soldbench_app:replace-with-strong-app-password@postgres:5432/soldbench
# Migration CLI one-shot job connection (schema DDL role):
MIGRATION_DATABASE_URL=postgresql://soldbench_migrator:replace-with-strong-migrator-password@postgres:5432/soldbench
# Isolated Collector connection (never holds billing/session secrets):
COLLECTOR_DATABASE_URL=postgresql://soldbench_collector:replace-with-strong-collector-password@postgres:5432/soldbench

# --- Application & Media Encryption Keys (API / Query Worker ONLY; NEVER pass to Collector) ---
LOCAL_STATE_ROOT=/var/lib/soldbench/state
SOURCE_URL_ENCRYPTION_KEY=replace-with-32-byte-hex-key

# --- Payment Provider Placeholders (API ONLY; disabled while PAYMENTS_MODE=offline) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# --- Collector Isolation Settings ---
MEDIA_ROOT=/var/lib/soldbench/media
COLLECTOR_DEMO_DIR=/var/lib/soldbench/spool
SOLDBENCH_BROWSER_BINARY=/usr/bin/chromium
