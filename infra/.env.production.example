# Native macOS PostgreSQL. DB bootstrap is an explicit operator command.
NODE_ENV=production
SOLDBENCH_ISOLATED_DEPLOYMENT=true
SOLDBENCH_LIVE_GATE_ACKNOWLEDGED=false
DATA_MODE=offline_fixture
COLLECTOR_ENABLED=false
PAYMENTS_MODE=offline
PAYMENT_FIXTURES=false
MAIL_TRANSPORT=offline

HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://soldbench.test:8080
SOLD_SITE_ADDRESS=http://soldbench.test:8080
SOLD_API_ADDRESS=http://api.soldbench.test:8080
SOLD_EDGE_BIND=127.0.0.1

POSTGRES_DB=soldbench
# POSTGRES_USER is the existing administrator used only by infra/db/provision.sh.
# POSTGRES_USER=
DATABASE_URL=postgresql://soldbench_runtime@127.0.0.1:5432/soldbench
DB_STARTUP_MODE=verify
# Assign an absolute PGPASSFILE private to each service account.
# PGPASSFILE=
# SOLDBENCH_SECRETS_DIR=
# AUTH_SECRETS_FILE=
AUTH_SECRETS_VERSION=initial

# Only after formal approval, set the real origin, Caddy addresses, and approved transports.
# SOLDBENCH_ISOLATED_DEPLOYMENT=false
# SOLDBENCH_LIVE_GATE_ACKNOWLEDGED=true
# APP_ORIGIN=https://soldbench.com
