# Production reverse-proxy template for SoldBench deployment targets.
# Domains (soldbench.com, api.soldbench.com) are deployment targets pending server provisioning, DNS/TLS verification, and launch gate approvals.

{
	email support@soldbench.com
	admin off
}

{$SOLD_SITE_ADDRESS:http://soldbench.test:8080} {
	bind {$SOLD_EDGE_BIND:127.0.0.1}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy {$SOLD_UPSTREAM:127.0.0.1:3000} {
		health_uri /ready
		health_interval 15s
		health_timeout 3s
	}
}

{$SOLD_API_ADDRESS:http://api.soldbench.test:8080} {
	bind {$SOLD_EDGE_BIND:127.0.0.1}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	request_body {
		max_size 2MB
	}
	@allowed_api path /v1/* /health /ready
	handle @allowed_api {
		reverse_proxy {$SOLD_UPSTREAM:127.0.0.1:3000} {
			health_uri /ready
			health_interval 15s
			health_timeout 3s
		}
	}
	handle {
		respond "Not Found" 404
	}
}
